+            self.qk_rope_head_dim,  # 0 (NoPE) or 64 (rope MLA)
+            1,  # page_size: top-k slots are the page table
+            False,  # causal: encoded by the indexer's selection
+            self.sm_scale,
+            q_data_type=torch.bfloat16,
+            kv_data_type=self.kv_dtype,
+        )
