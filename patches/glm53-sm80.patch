+    expand_pools_and_append_tail,
+    expand_pools_to_tokens,
+    kpool_compress_and_write_cache,
+    kpool_decode_update_and_maybe_write_cache_batched,
+    kpool_seed_tail_cache,
+)
+from vllm.platforms import current_platform
